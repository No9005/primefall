  "8": { "class_type": "CLIPTextEncode", "inputs": { "clip": ["3", 1], "text": "detailed pixel art character sprite, 16-bit game art, young woman engineer, brown hair in a ponytail, teal glowing goggles on her forehead, frayed orange sleeveless top, grey metal chest plate with a glowing teal reactor core, grey robotic right arm with a claw hand, bare left arm with a cyan emitter cuff, long mechanical grey third arm with three segments, teal glowing joints and a pincer rising from her back over her shoulder, patched grey-brown trousers, dark brown boots, black outline, rich shading, metal highlights, full body, flat grey background" }, "_meta": { "title": "Prompt: Tilly's look" } },
  "9": { "class_type": "CLIPTextEncode", "inputs": { "clip": ["3", 1], "text": "blurry, photo, realistic, 3d render, extra limbs, extra arms, deformed hands, text, watermark, gradient background, anti-aliasing, cropped" }, "_meta": { "title": "Negative prompt" } },
  "10": { "class_type": "LoadImage", "inputs": { "image": "tilly-guide-idle-0.png" }, "_meta": { "title": "Rig frame to dress (render-pose-guides.mjs)" } },
