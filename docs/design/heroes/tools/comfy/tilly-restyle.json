  "13": { "class_type": "SetUnionControlNetType", "inputs": { "control_net": ["12", 0], "type": "tile" }, "_meta": { "title": "Control type: tile (keeps the shapes)" } },
  "14": { "class_type": "ControlNetApplyAdvanced", "inputs": { "positive": ["8", 0], "negative": ["9", 0], "control_net": ["13", 0], "image": ["10", 0], "vae": ["1", 2], "strength": 0.8, "start_percent": 0.0, "end_percent": 0.8 }, "_meta": { "title": "Hold the rig frame's shapes (strength)" } },
  "18": { "class_type": "VAEEncode", "inputs": { "pixels": ["10", 0], "vae": ["1", 2] }, "_meta": { "title": "Encode the rig frame" } },
  "19": { "class_type": "KSampler", "inputs": { "model": ["3", 0], "positive": ["14", 0], "negative": ["14", 1], "latent_image": ["18", 0], "seed": 1, "control_after_generate": "fixed", "steps": 30, "cfg": 6.0, "sampler_name": "dpmpp_2m", "scheduler": "karras", "denoise": 0.55 }, "_meta": { "title": "Sampler (denoise: how far the look may leave the rig frame)" } },
