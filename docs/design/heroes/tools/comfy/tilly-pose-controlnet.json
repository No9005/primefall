{
  "1": { "class_type": "CheckpointLoaderSimple", "inputs": { "ckpt_name": "sd_xl_base_1.0.safetensors" }, "_meta": { "title": "SDXL base (text encoder and VAE)" } },
  "2": { "class_type": "UNETLoader", "inputs": { "unet_name": "sd_xl_inpainting_0.1_unet_fp16.safetensors", "weight_dtype": "default" }, "_meta": { "title": "SDXL inpainting UNet" } },
  "3": { "class_type": "LoraLoader", "inputs": { "model": ["2", 0], "clip": ["1", 1], "lora_name": "pixel-art-xl.safetensors", "strength_model": 1.0, "strength_clip": 1.0 }, "_meta": { "title": "Pixel art LoRA" } },
  "4": { "class_type": "IPAdapterModelLoader", "inputs": { "ipadapter_file": "ip-adapter-plus_sdxl_vit-h.safetensors" }, "_meta": { "title": "IP-Adapter plus SDXL" } },
  "5": { "class_type": "CLIPVisionLoader", "inputs": { "clip_name": "CLIP-ViT-H-14-laion2B-s32B-b79K.safetensors" }, "_meta": { "title": "CLIP vision ViT-H" } },
  "6": { "class_type": "LoadImage", "inputs": { "image": "tilly-source.png" }, "_meta": { "title": "Who she is: Tilly of the map (reference for the IP-Adapter)" } },
  "7": { "class_type": "IPAdapterAdvanced", "inputs": { "model": ["3", 0], "ipadapter": ["4", 0], "image": ["6", 0], "clip_vision": ["5", 0], "weight": 0.9, "weight_type": "linear", "combine_embeds": "concat", "start_at": 0.0, "end_at": 1.0, "embeds_scaling": "V only" }, "_meta": { "title": "Keep her look (weight: how strictly)" } },
  "8": { "class_type": "CLIPTextEncode", "inputs": { "clip": ["3", 1], "text": "pixel art, 16-bit game sprite, full body, young woman engineer with a brown ponytail and teal goggles on her forehead, orange sleeveless top with a glowing teal chest reactor, a grey robotic right arm, a long mechanical third arm with a claw rising from her back, brown trousers and boots, flat grey background" }, "_meta": { "title": "Prompt (the pose comes from the guide, not from here)" } },
  "9": { "class_type": "CLIPTextEncode", "inputs": { "clip": ["3", 1], "text": "blurry, photo, realistic, 3d render, extra limbs, extra arms, deformed hands, text, watermark, gradient, soft shading, anti-aliasing" }, "_meta": { "title": "Negative prompt" } },
  "10": { "class_type": "LoadImage", "inputs": { "image": "tilly-guide-pulse-620.png" }, "_meta": { "title": "Pose guide (from the rig: render-pose-guides.mjs)" } },
  "11": { "class_type": "Canny", "inputs": { "image": ["10", 0], "low_threshold": 0.3, "high_threshold": 0.7 }, "_meta": { "title": "Outline of the pose" } },
  "12": { "class_type": "ControlNetLoader", "inputs": { "control_net_name": "controlnet-union-sdxl-1.0-promax.safetensors" }, "_meta": { "title": "ControlNet union SDXL" } },
  "13": { "class_type": "SetUnionControlNetType", "inputs": { "control_net": ["12", 0], "type": "canny/lineart/anime_lineart/mlsd" }, "_meta": { "title": "Control type: outline" } },
  "14": { "class_type": "ControlNetApplyAdvanced", "inputs": { "positive": ["8", 0], "negative": ["9", 0], "control_net": ["13", 0], "image": ["11", 0], "vae": ["1", 2], "strength": 0.9, "start_percent": 0.0, "end_percent": 0.85 }, "_meta": { "title": "Pose from the guide (strength: how strictly)" } },
  "15": { "class_type": "LoadImage", "inputs": { "image": "tilly-blank.png" }, "_meta": { "title": "Page to paint on (for an intro frame: the scene)" } },
  "16": { "class_type": "LoadImageMask", "inputs": { "image": "tilly-mask-figure.png", "channel": "red" }, "_meta": { "title": "Where she may appear" } },
  "17": { "class_type": "GrowMask", "inputs": { "mask": ["16", 0], "expand": 8, "tapered_corners": true }, "_meta": { "title": "Grow the mask" } },
  "18": { "class_type": "InpaintModelConditioning", "inputs": { "positive": ["14", 0], "negative": ["14", 1], "vae": ["1", 2], "pixels": ["15", 0], "mask": ["17", 0], "noise_mask": true }, "_meta": { "title": "Inpaint conditioning" } },
  "19": { "class_type": "KSampler", "inputs": { "model": ["7", 0], "positive": ["18", 0], "negative": ["18", 1], "latent_image": ["18", 2], "seed": 1, "control_after_generate": "fixed", "steps": 30, "cfg": 6.0, "sampler_name": "dpmpp_2m", "scheduler": "karras", "denoise": 1.0 }, "_meta": { "title": "Sampler" } },
  "20": { "class_type": "VAEDecode", "inputs": { "samples": ["19", 0], "vae": ["1", 2] }, "_meta": { "title": "Decode" } },
  "21": { "class_type": "ImageCompositeMasked", "inputs": { "destination": ["15", 0], "source": ["20", 0], "x": 0, "y": 0, "resize_source": false, "mask": ["17", 0] }, "_meta": { "title": "Paste her into the page" } },
  "22": { "class_type": "SaveImage", "inputs": { "images": ["21", 0], "filename_prefix": "tilly-pose/cn" }, "_meta": { "title": "Save (1024 px)" } },
  "23": { "class_type": "ImageScaleBy", "inputs": { "image": ["21", 0], "upscale_method": "nearest-exact", "scale_by": 0.125 }, "_meta": { "title": "Back to sprite size (1/8)" } },
  "24": { "class_type": "SaveImage", "inputs": { "images": ["23", 0], "filename_prefix": "tilly-pose/cn-small" }, "_meta": { "title": "Save (128 px)" } }
}
